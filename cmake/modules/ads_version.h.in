//============================================================================
/// \file   ads_version.h
/// \author auto-generated
/// \date   @QtADS_AUTO_GEN_DATE@
/// \brief  ADS version information
//============================================================================

// ADS version components
#define ADS_VERSION_MAJOR @QtADS_VERSION_MAJOR@
#define ADS_VERSION_MINOR @QtADS_VERSION_MINOR@
#define ADS_VERSION_PATCH @QtADS_VERSION_PATCH@

// ADS_VERSION is (major << 16) | (minor << 8) | patch.
#define ADS_VERSION ADS_VERSION_CHECK(ADS_VERSION_MAJOR, ADS_VERSION_MINOR, ADS_VERSION_PATCH)

// generates a complete version from the major, minor, and patch values
// i.e. #if ADS_VERSION >= ADS_VERSION_CHECK(5, 0, 0)
#define ADS_VERSION_CHECK(major, minor, patch) ((major<<16) | (minor<<8) | (patch))

#endif // ads_versionH
